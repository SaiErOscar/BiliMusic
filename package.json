{
  "name": "bilimusic",
  "private": true,
  "version": "1.2.27",
  "description": "BiliMusic - 基于 Bilibili 的桌面音乐播放器",
  "author": "SaiErOscar",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run copy-preload",
    "preview": "vite preview",
    "copy-preload": "node -e \"const fs=require('fs');fs.cpSync('electron/preload.cjs','dist-electron/preload.cjs');fs.cpSync('electron/tray-preload.cjs','dist-electron/tray-preload.cjs');fs.cpSync('electron/mini-preload.cjs','dist-electron/mini-preload.cjs');fs.cpSync('electron/icon.png','dist-electron/icon.png');if(fs.existsSync('electron/tray.png'))fs.cpSync('electron/tray.png','dist-electron/tray.png')\"",
    "electron:dev": "vite",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "lint": "eslint src/ electron/ --ext .ts,.tsx,.cjs",
    "lint:fix": "eslint src/ electron/ --ext .ts,.tsx,.cjs --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:ota": "npm run build && node scripts/build-ota.mjs",
    "build:web": "node scripts/build-web.mjs",
    "cap:sync": "npm run build:web && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.12.0",
    "lucide-react": "^0.511.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.saieroscar.bilimusic",
    "productName": "BiliMusic",
    "copyright": "Copyright © 2026 SaiErOscar",
    "publish": [
      {
        "provider": "github",
        "owner": "SaiErOscar",
        "repo": "BiliMusic"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/ffmpeg-static/**",
      "node_modules/fluent-ffmpeg/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BiliMusic",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "BiliMusic ${version}",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerSidebar": "build/installerSidebar.bmp"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "electron/icon.png",
      "category": "public.app-category.music",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "electron/icon.png",
      "category": "AudioVideo",
      "maintainer": "SaiErOscar",
      "synopsis": "基于 Bilibili 的桌面音乐播放器",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/fluent-ffmpeg/**"
    ]
  }
}
