# BiliMusic Android release 签名配置模板
# 用法：复制本文件为 keystore.properties，填入真实值（keystore.properties 已被 .gitignore 忽略，勿提交）
# storeFile 相对 android/app/ 目录解析，这里指向 android/ 目录下的 keystore

storeFile=../bilimusic-release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=bilimusic
keyPassword=YOUR_KEY_PASSWORD
